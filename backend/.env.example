# 复制为 .env 后填写真实值。.env 已被 .gitignore 排除。
# 本文件只保留占位符：任何真实密钥都不得写进仓库、日志或聊天记录。
#
# 分工：conf/*.yaml 放非敏感工程参数；本文件只放密钥与本机环境覆盖项。
# 优先级：环境变量 > .env > conf/app_config.yaml

# 推荐使用标准名（shell 可直接 export）；兼容原始命名 aliQwen-api（含连字符，shell 不支持 export）
ALIQWEN_API_KEY=your-api-key-here
# aliQwen-api=

# 以下三项若不填，使用 conf/app_config.yaml 中的默认值
 ALIQWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
 ALIQWEN_MODEL=qwen3.8-max

# mock = 内置确定性规划器（不联网、不消耗额度，用于验证工程链路）
# real = 调用真模型；未配置密钥时会自动降级为 mock 并在响应中标注
LLM_MODE=mock

# react = 现有 SSE ReAct 链路；langgraph = 教程式多阶段编排图
AGENT_ENGINE=react

# 本机型路径（默认 ./data，即 backend/data）
APP_DATA_DIR=./data

# 以下护栏参数若不填，使用 conf/app_config.yaml 的 agent.* 默认值
# AGENT_MAX_STEPS=8
# AGENT_STEP_TIMEOUT=20
# AGENT_TOTAL_TIMEOUT=90
# AGENT_MAX_SQL_CORRECTIONS=2
# AGENT_MAX_ROWS=500
# MCP_ENABLED=false
